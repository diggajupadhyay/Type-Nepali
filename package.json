{
  "name": "type-nepali",
  "version": "1.5.1",
  "description": "A browser extension to help with Nepali typing - Real-time English to Nepali transliteration",
  "author": "Jay Nepal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diggajupadhyay/Type-Nepali.git"
  },
  "keywords": [
    "nepali",
    "typing",
    "transliteration",
    "browser-extension",
    "firefox",
    "chrome"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "zip": "npm run build && node scripts/zip-extension.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "firefox >= 100",
    "chrome >= 88"
  ]
}
